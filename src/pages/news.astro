---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { latestWayback } from '../lib/wayback';

const news = await Promise.all(
  (await getCollection('news'))
    .sort(
      (a, b) =>
        b.data.year - a.data.year ||
        (b.data.startDate?.valueOf() ?? 0) - (a.data.startDate?.valueOf() ?? 0),
    )
    .map(async (item) => ({
      ...item,
      href: item.data.url ? await latestWayback(item.data.url) : undefined,
    })),
);

const sections = [
  { heading: 'Selected Shows', items: news.filter((n) => n.data.category === 'show') },
  { heading: 'Selected Talks', items: news.filter((n) => n.data.category === 'talk') },
  { heading: 'Selected Workshops', items: news.filter((n) => n.data.category === 'workshop') },
  { heading: 'Residencies', items: news.filter((n) => n.data.category === 'residency') },
];
---

<Base title="News – Xin Xin" active="news">
  {
    sections.map(
      (section) =>
        section.items.length > 0 && (
          <section class="news-section">
            <h2>{section.heading}</h2>
            <ul class="news-grid">
              {section.items.map((item) => (
                <li>
                  {item.href ? (
                    <a href={item.href}>
                      {item.data.year}, {item.data.title}, {item.data.venue}
                    </a>
                  ) : (
                    <>
                      {item.data.year}, {item.data.title}, {item.data.venue}
                    </>
                  )}
                </li>
              ))}
            </ul>
          </section>
        ),
    )
  }
</Base>
