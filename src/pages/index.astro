---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { latestWayback } from '../lib/wayback';

// Show events within six months of the build date, either side.
// An event counts as "in the window" if its date range overlaps it.
const now = new Date();
const windowStart = new Date(now);
windowStart.setMonth(windowStart.getMonth() - 6);
const windowEnd = new Date(now);
windowEnd.setMonth(windowEnd.getMonth() + 6);

const news = await Promise.all(
  (
    await getCollection('news', ({ data }) => {
      if (!data.startDate) return false;
      const end = data.endDate ?? data.startDate;
      return end >= windowStart && data.startDate <= windowEnd;
    })
  )
    .sort((a, b) => b.data.startDate!.valueOf() - a.data.startDate!.valueOf())
    .map(async (item) => ({
      ...item,
      href: item.data.url ? await latestWayback(item.data.url) : undefined,
    })),
);

const works = (await getCollection('works', ({ data }) => data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="Xin Xin">
  <div class="split">
    <section>
      <h2 class="section-label">News or current</h2>
      <ul class="index-list">
        {
          news.map((item) => (
            <li>
              {item.href ? (
                <a href={item.href}>
                  <div class="item-title">
                    {item.data.venue} – {item.data.title}
                  </div>
                  {item.data.date && <div class="item-meta">{item.data.date}</div>}
                </a>
              ) : (
                <>
                  <div class="item-title">
                    {item.data.venue} – {item.data.title}
                  </div>
                  {item.data.date && <div class="item-meta">{item.data.date}</div>}
                </>
              )}
            </li>
          ))
        }
      </ul>
    </section>
    <section class="image-stack">
      {
        works.map((work) => (
          <a href={`/works/${work.id}/`}>
            <figure>
              <img
                src={work.data.heroImage}
                alt={work.data.heroImageAlt || work.data.title}
                loading="lazy"
              />
            </figure>
          </a>
        ))
      }
    </section>
  </div>
</Base>
